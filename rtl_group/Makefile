.PHONY: all vcs compile run sim verdi clean help

# Server-side VCS/Verdi RTL simulation for tb_g03_basic_instr.
# Run this Makefile from the rtl_group directory.
VCS          ?= vcs
VERDI        ?= Verdi-Ultra
TOP          ?= tb_g03_basic_instr
FILELIST     ?= tb/g03_basic_instr.f
BUILD_DIR    ?= build/g03_basic_instr
SIMV         := $(BUILD_DIR)/simv
FSDB         := $(BUILD_DIR)/g03_basic_instr.fsdb
VCS_LOG      := $(BUILD_DIR)/vcs.log
SIM_LOG      := $(BUILD_DIR)/sim.log
VERDI_LOG    := $(BUILD_DIR)/verdi.log

# Most teaching servers export VERDI_HOME or NOVAS_HOME after the tool
# environment is initialized.  Override FSDB_PLI when the local layout differs.
NOVAS_HOME   ?= $(VERDI_HOME)
FSDB_PLI     ?=
ifeq ($(strip $(FSDB_PLI)),)
ifneq ($(strip $(NOVAS_HOME)),)
FSDB_PLI := -P $(NOVAS_HOME)/share/PLI/VCS/LINUX64/novas.tab \
            $(NOVAS_HOME)/share/PLI/VCS/LINUX64/pli.a
endif
endif

INC_DIRS := \
    +incdir+tb \
    +incdir+top \
    +incdir+top/gpr \
    +incdir+top/perips \
    +incdir+top/perips/bridge \
    +incdir+core00_wzc \
    +incdir+core00_wzc/core \
    +incdir+core00_wzc/utils \
    +incdir+core01_xyh \
    +incdir+core01_xyh/utils \
    +incdir+core10_hjx \
    +incdir+core10_hjx/core \
    +incdir+core10_hjx/utils

VCS_FLAGS := \
    -v2005 \
    -full64 \
    -timescale=1ns/1ps \
    -debug_access+all \
    -top $(TOP) \
    $(INC_DIRS) \
    -f $(FILELIST) \
    -Mdir=$(BUILD_DIR)/csrc \
    -o $(SIMV) \
    -l $(VCS_LOG)

# Set DUMP_FSDB=0 when only a console run is wanted.  For FSDB dumping,
# NOVAS_HOME/VERDI_HOME must point to the server's Verdi installation, or
# FSDB_PLI must be supplied explicitly on the make command line.
DUMP_FSDB ?= 1
ifeq ($(DUMP_FSDB),1)
DUMP_FLAGS := +define+G03_DUMP_FSDB $(FSDB_PLI)
else
DUMP_FLAGS :=
endif

all: sim

# Keep the tutorial-compatible target name: make vcs compiles and runs.
vcs: sim

compile:
	mkdir -p $(BUILD_DIR)/csrc
	$(VCS) $(VCS_FLAGS) $(DUMP_FLAGS)

run: compile
	$(SIMV) -l $(SIM_LOG)

sim: run

verdi:
	@test -f $(FSDB) || { echo "Missing $(FSDB). Run 'make vcs' first."; exit 1; }
	$(VERDI) -sv $(INC_DIRS) -f $(FILELIST) -ssf $(FSDB) -nologo -l $(VERDI_LOG) &

clean:
	rm -rf $(BUILD_DIR) Verdi-SXLog Verdi-UltraLog

help:
	@echo "make vcs     Compile, run, and create $(FSDB)"
	@echo "make verdi   Open the FSDB generated by make vcs"
	@echo "make clean   Remove generated simulation output"
